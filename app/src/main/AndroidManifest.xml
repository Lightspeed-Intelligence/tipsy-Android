<?xml version="1.0" encoding="utf-8"?>
<!--
  壳工程主 Manifest。
  W0 只承载「能启动 + 能挂 DebugSurface」，不引入真实业务能力。

  §2.3 的 config plugin 移植状态（这些 patch 在 brownfield 不会自动生效）：
  - withAndroidLargeHeap      → 已移植（下方 android:largeHeap）
  - withAndroidStyles         → 见 res/values/styles.xml
  - withVoiceCallSystemSession→ 未移植（W4 随 voice 能力接入）
  - withRemoveAgoraMediaProjection → 见 build.gradle 的依赖替换；权限移除见下方
  - withRuStoreBilling        → 未移植（W0 不接支付，届时走 ruStore flavor source set）
  漏移植是静默失效，动到相关能力时必须回查方案 §2.3。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      withRemoveAgoraMediaProjection 的等价处理：Agora full-sdk 会带入屏幕录制
      相关权限，本产品不使用（且属商店审核敏感项），显式移除。
      依赖侧的 full-sdk→voice-sdk 替换见根 build.gradle。
    -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"
        tools:node="remove" />

    <application
        android:name=".TipsyApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false"
        tools:replace="android:allowBackup">

        <!--
          withAndroidLargeHeap 的等价处理。注释原文记录这是线上 Android OOM
          崩溃的缓解措施（多个 ExoPlayer 实例并存时默认堆不足，
          java.lang.OutOfMemoryError @ ExoPlayerImplInternal.shouldContinueLoading）。
          Screen 波次（W4）迁 Media3 时这一项必须在位，且不得当作 OOM 的唯一修复。
        -->
        <meta-data
            android:name="tipsy.largeHeap.note"
            android:value="see android:largeHeap on application" />

        <!--
          react-native-fbsdk-next 的 config plugin 等价处理（2026-08-17 实测）。

          ⚠️ **缺了这几项会让挂载任何 RN Surface 直接 SIGABRT**，不是 Kotlin
          异常而是 native abort，所以 try/catch 拦不住：

            JNI DETECTED ERROR IN APPLICATION: ... pending exception
            com.facebook.FacebookSdkNotInitializedException
              at com.facebook.AccessTokenTracker.<init>(AccessTokenTracker.kt:49)
              at FBAccessTokenModule.initialize(FBAccessTokenModule.java:61)
              at TurboModuleManager.getOrCreateModule(TurboModuleManager.kt:259)

          `TurboModuleManager` 在 Surface 起 runtime 时实例化全部 legacy 模块，
          `FBAccessTokenModule` 一构造就要求 SDK 已初始化。**与哪个 Surface 无关**
          （崩溃 trace 里零壳类）—— 只是 P9 放开 ChatDetail 后第一次可达。

          注意这个 plugin **不在** `tipsy-app/plugins/` 里（方案 §2.3 列的那 6 个），
          它由 node_modules 自带、`app.config.js:271` 配置，所以按「六个 plugin」
          清单逐项移植时会漏掉它。`FacebookInitProvider` 本身被 autolinking
          合并进来了，缺的只有 meta-data —— 这也是它在构建期查不出来的原因。

          ⚠️ **值走 CI secret / placeholder，不抄 app.config.js 的字面量**：
          那里的 appID/clientToken 属方案 §12.7 的 credential-like 值，
          安全 owner 出结论前不读取、不复制进本仓。当前 placeholder 让壳能跑通
          Surface；**真实登录/归因要等凭据到位**（同 §12.8 签名指纹的处理方式）。

          `AutoInitEnabled=false` 与 `AutoLogAppEventsEnabled=false` 是**现网配置**
          （`app.config.js` 的 `isAutoInitEnabled/autoLogAppEventsEnabled: false`），
          别顺手改成 true —— 那会让壳的埋点行为与现网不一致。
          初始化由 JS 侧 `Settings.initializeSDK()` 显式调用
          （`lib/attribution/providers/meta.ts:17`）。
        -->
        <meta-data
            android:name="com.facebook.sdk.ApplicationId"
            android:value="@string/facebook_app_id" />
        <meta-data
            android:name="com.facebook.sdk.ClientToken"
            android:value="@string/facebook_client_token" />
        <meta-data
            android:name="com.facebook.sdk.AutoInitEnabled"
            android:value="false" />
        <meta-data
            android:name="com.facebook.sdk.AutoLogAppEventsEnabled"
            android:value="false" />
        <meta-data
            android:name="com.facebook.sdk.AdvertiserIDCollectionEnabled"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/AppTheme"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              app scheme 深链（W1-P4）。七条路径见 AppRouteParser，
              逐字对齐 RN 的 linking.config（src/App.tsx:445-465）。

              ⚠️ **刻意不声明 fb / twitter / discord / instagram / tiktok**
              这五个通用 scheme（RN 侧 app.config.js:147-171 有）。
              审计结论（W1 计划 §6.3）：全仓 25 处 Linking.openURL 没有任何一处
              打开它们；注册成自己的 filter 与「能否跳出到社交 App」无关 ——
              跳出靠 openURL，注册只意味着「愿意接收入站」。
              收益为零，代价是五个通用 scheme 的入站劫持面。

              若将来需要从社交 App 回跳，要的是各家分配的**带 client id 的专属
              scheme**（如 fb1819240725563515://），不是通用的 fb://。
            -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tipsy" />
            </intent-filter>
        </activity>
    </application>

</manifest>
